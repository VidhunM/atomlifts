{
  "rewrites": [
    {
      "source": "/api/proxy",
      "destination": "/api/proxy"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?targetPath=/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://3.6.89.246/uploads/:path*"
    }
  ]
}